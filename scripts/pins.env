# Every pin the console build depends on. docs/pins.md says what each is for.
# The Rust toolchain (rust-toolchain.toml carries the same value).
RUST_NIGHTLY=nightly-2026-10-04
# The shared crates (Cargo.toml carries the same rev).
PUNKTFUNK_REV=7ef864d4a58f22b31d57579f52421258e8b1d86d
# devkitPro packages the image checks after -Syu (docker/Dockerfile carries the same values).
DEVKITA64=r30-1
LIBNX=4.12.0-1
SWITCH_TOOLS=1.13.1-1
# The base image: devkitpro/devkita64, by digest (amd64 + arm64).
DEVKITA64_IMAGE=devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282
# bevy-horizon: the target JSON and the crate legs under toolchain/ came from this commit.
BEVY_HORIZON_REPO=https://github.com/JohnUzoka/bevy-horizon
BEVY_HORIZON_REV=3eac779b232ee47cd0eb957676c64386ac7b0f1d
# The toolchain image's tag; bump it with any pin above.
NX_IMAGE=punktfunk-nx-toolchain:1
# The dev box's image (docker/host.Dockerfile); bump it with RUST_NIGHTLY or the file.
HOST_IMAGE=punktfunk-nx-host:2
